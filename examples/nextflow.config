/*
 * Example Nextflow configuration for nf-codespaces plugin
 *
 * This configuration demonstrates how to use GitHub Codespaces
 * as the execution environment for Nextflow tasks.
 */

plugins {
  id 'nf-codespaces@0.1.0'
}

// Configure the codespaces executor
process {
  executor = 'codespaces'
  
  // Codespace configuration
  ext.codespaces {
    // Required: Your GitHub repository
    repo = 'your-org/your-repo'
    
    // Optional: Branch to use for codespace creation
    // Defaults to the repository's default branch if not specified
    branch = 'main'
    
    // Optional: Use local gh CLI instead of Docker (default: false)
    // Set to true if you have gh installed locally and prefer to use it
    useLocalGh = false
  }
}

// Example: Apply codespaces only to specific processes
process {
  withName: 'HEAVY_COMPUTE' {
    executor = 'codespaces'
    ext.codespaces {
      repo = 'your-org/compute-repo'
    }
  }
  
  withName: 'LIGHT_TASK' {
    executor = 'local'  // Run locally
  }
}
